# Plantilla de Nginx para E-clothes.
#
# Cumple dos funciones a la vez (regla del taller: "Nginx o un proxy dirigirá
# cada ruta al microservicio correspondiente"):
#   1) Sirve los archivos estáticos del build de React (SPA).
#   2) Actúa como proxy inverso: cada ruta /api/v1/<recurso> se reenvía al
#      contenedor del microservicio dueño de ese recurso.
#
# Al usar el mismo origen (mismo dominio/puerto) para el frontend y la API,
# NO hay problemas de CORS entre el navegador y los microservicios: el
# navegador solo habla con este proxy.
#
# Este archivo es una PLANTILLA: nginx (imagen oficial >=1.19) sustituye
# automáticamente las variables ${...} al arrancar el contenedor, usando los
# valores definidos en docker-compose.yml, y escribe el resultado en
# /etc/nginx/conf.d/default.conf.
#
# IMPORTANTE — desfase de contrato detectado (ver docs/F-frontend-eclothes.md):
#   - David (insumos) expone actualmente /api/v1/materials/ en vez de
#     /api/v1/insumos/.
#   - Camilo (materiales-mercado) expone actualmente /api/v1/market-materials/
#     en vez de /api/v1/materiales-mercado/.
# Este proxy asume que ambos ajustarán sus rutas al contrato acordado. Si no
# lo han hecho todavía, deja VITE_MOCK_INSUMOS / VITE_MOCK_MATERIALES_MERCADO
# en "true" en el .env del frontend mientras tanto: así el proxy no se usa
# para esos dos módulos y no hace falta tocar esta plantilla.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compresión básica para el bundle de producción.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # --- Insumos (David) --------------------------------------------------
    location /api/v1/insumos/ {
        proxy_pass ${INSUMOS_SERVICE_URL}/api/v1/insumos/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # --- Materiales de mercado (Camilo) ------------------------------------
    location /api/v1/materiales-mercado/ {
        proxy_pass ${MERCADO_SERVICE_URL}/api/v1/materiales-mercado/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # --- Consejos (Sara) — ya cumple el contrato ---------------------------
    location /api/v1/consejos/ {
        proxy_pass ${CONSEJOS_SERVICE_URL}/api/v1/consejos/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # --- Prendas (Nicol) ----------------------------------------------------
    location /api/v1/prendas/ {
        proxy_pass ${PRENDAS_SERVICE_URL}/api/v1/prendas/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # --- SPA de React: cualquier otra ruta cae en index.html ---------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cachea agresivamente los assets versionados por Vite (contienen hash).
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
