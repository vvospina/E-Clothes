# =============================================================
# Django — se mantienen igual que en el backend original
# =============================================================
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# =============================================================
# CORS — igual que antes
# =============================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================
# AGREGADO: base de datos MySQL de este microservicio
# =============================================================
DB_NAME=market_materials
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306

# =============================================================
# ELIMINADAS: eran las variables que usaba companies/mongo.py
# para conectarse a MongoDB. Revisa tu .env original: si tenías
# algo como MONGO_URI o MONGO_DB_NAME, bórralas, ya no aplican
# a este microservicio.
# =============================================================
# MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net
# MONGO_DB_NAME=ecored

# =============================================================
# Firebase — PENDIENTE. La ruta anterior apuntaba al proyecto
# viejo de EcoRed (el que usa companies). NO la reutilices.
# Cuando el equipo cree el nuevo proyecto Firebase y tengas el
# JSON de credenciales, descomenta y ajusta esta línea, y sigue
# los 3 pasos del final de README_MATERIALS.md:
# =============================================================
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account-materials.json
