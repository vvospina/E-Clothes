# =============================================================
# Django — se mantienen igual que en el backend original
# =============================================================
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# =============================================================
# CORS — igual que antes
# =============================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================
# AGREGADO: conexión a MongoDB de este microservicio
# (mismo estilo que companies/mongo.py: URI completa + nombre de BD)
# =============================================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=market_materials

# =============================================================
# ELIMINADAS: eran del enfoque anterior con MySQL.
# =============================================================
# DB_NAME=market_materials
# DB_USER=root
# DB_PASSWORD=changeme
# DB_HOST=localhost
# DB_PORT=3306

# =============================================================
# Firebase — PENDIENTE. La ruta anterior apuntaba al proyecto
# viejo de EcoRed (el que usa companies). NO la reutilices.
# Cuando el equipo cree el nuevo proyecto Firebase y tengas el
# JSON de credenciales, descomenta y ajusta esta línea, y sigue
# los 3 pasos del final de README_MATERIALS.md:
# =============================================================
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account-materials.json
